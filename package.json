{
  "name": "cgl-gk-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, bilingual SSC CGL General Awareness practice app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run test && npm run build",
    "content:validate": "tsx tools/content/cli.ts validate",
    "content:build": "tsx tools/content/cli.ts build",
    "content:keygen": "tsx tools/content/cli.ts keygen"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "dexie": "^4.4.7",
    "svelte": "^5.57.3",
    "ts-fsrs": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
