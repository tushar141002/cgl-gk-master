# Build-time configuration (D-073). Values are public in the bundle: the anon
# key is protected by Row-Level Security, never put a service key here.
#
# Missing values make the build guest-only: practice works, sign-in is hidden.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Must be allow-listed in Supabase Auth → URL Configuration, and matches the
# intent filter in android/app/src/main/AndroidManifest.xml.
VITE_AUTH_REDIRECT_URL=com.cglgkmaster.app://auth-callback
